@model WebsiteBanHang.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-4 text-center">
    <div class="alert alert-danger shadow">
        <h3>Bạn có chắc chắn muốn xóa sản phẩm này không?</h3>
        <p class="mb-0 text-muted">Hành động này không thể hoàn tác!</p>
    </div>

    <div class="card shadow mx-auto mt-3" style="max-width: 500px;">
        <div class="card-body">
            <h4 class="text-danger">@Model.Name</h4>
            <p class="font-weight-bold text-muted">Danh mục: @Model.Category.Name</p>
            <hr />
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-5">Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Hủy</a>
            </form>
        </div>
    </div>
</div>