@model WebsiteBanHang.Models.Product

<div class="container mt-4">
    <div class="card shadow p-4 mx-auto" style="max-width: 500px;">
        <h4 class="text-center text-success">THÊM SẢN PHẨM</h4>
        <form asp-action="Create">
            <div class="form-group">
                <label class="control-label font-weight-bold">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label font-weight-bold">Giá bán</label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label font-weight-bold">Chọn danh mục</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            </div>
            <div class="mt-3 text-center">
                <input type="submit" value="Lưu lại" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>