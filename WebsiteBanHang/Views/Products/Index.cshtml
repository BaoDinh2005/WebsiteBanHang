@model IEnumerable<WebsiteBanHang.Models.Product>

<div class="container mt-4">
    <h2 class="text-center text-primary">DANH SÁCH SẢN PHẨM (LAB 04)</h2>
    <p><a asp-action="Create" class="btn btn-success">Thêm sản phẩm mới</a></p>
    <table class="table table-bordered table-striped shadow">
        <thead class="thead-dark">
            <tr>
                <th>Tên sản phẩm</th>
                <th>Giá bán</th>
                <th>Danh mục</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-danger font-weight-bold">@item.Price.ToString("N0") đ</td>
                    <td><span class="badge badge-info p-2">@item.Category.Name</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>