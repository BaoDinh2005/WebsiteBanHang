@model WebsiteBanHang.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow mx-auto" style="max-width: 600px;">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Thông tin chi tiết sản phẩm</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 font-weight-bold">Tên sản phẩm:</dt>
                <dd class="col-sm-8 text-primary font-weight-bold">@Model.Name</dd>

                <dt class="col-sm-4 font-weight-bold">Giá bán:</dt>
                <dd class="col-sm-8 text-danger">@Model.Price.ToString("N0") VNĐ</dd>

                <dt class="col-sm-4 font-weight-bold">Danh mục:</dt>
                <dd class="col-sm-8"><span class="badge badge-primary p-2">@Model.Category.Name</span></dd>
            </dl>
            <hr />
            <div class="text-center">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>